# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agile:agile@db:5432/agile_intel
DATABASE_URL_SYNC=postgresql://agile:agile@db:5432/agile_intel

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Jira Cloud ───────────────────────────────────────────────────────────────
# Create an OAuth 2.0 app at: https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
JIRA_REDIRECT_URI=http://localhost:8000/api/v1/integrations/jira/callback
# OR use a service account API token for simpler setup:
JIRA_SERVICE_EMAIL=you@yourdomain.com
JIRA_SERVICE_API_TOKEN=your-jira-api-token
JIRA_CLOUD_ID=your-jira-cloud-id         # from https://yoursite.atlassian.net/_edge/tenant_info
JIRA_BASE_URL=https://yoursite.atlassian.net

# ── Slack (Phase 3) ──────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ── Google (Phase 3) ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# ── Pipeline schedules (cron expressions) ────────────────────────────────────
JIRA_SYNC_INTERVAL_MINUTES=15
SLACK_SYNC_INTERVAL_MINUTES=30
TRANSCRIPT_SYNC_INTERVAL_MINUTES=60
